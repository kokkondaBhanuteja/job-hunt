# Copy to .env.local — overrides defaults if present.
# Defaults work fine; touch only if you switch models, hosts, datastore, or enable email.

# ---------- API server ----------
# Bearer token the API + web UI require. For the Docker stack you do NOT set this:
# `make up` auto-generates a shared token into the repo-root env file and nginx
# injects it on every /api request, so the UI needs no token. Set it here only for
# host-native `hunt serve-api`. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# ---------- Datastore ----------
# sqlite (default; the test path) or postgres (the production datastore).
DB_BACKEND=sqlite
# Used when DB_BACKEND=postgres. `docker compose up -d` starts this on host port 55432.
DATABASE_URL=postgresql://jobhunt:jobhunt@localhost:55432/jobhunt

# ---------- LLM (pluggable, per task: local model OR API key) ----------
OLLAMA_URL=http://localhost:11434
# Per-task routing. Provider: ollama | openai | gemini | groq | stub.
LLM_SCORING_PROVIDER=ollama
LLM_SCORING_MODEL=qwen2.5:7b
LLM_DRAFTING_PROVIDER=ollama
LLM_DRAFTING_MODEL=qwen2.5:7b
# Inbox email structuring (falls back to the scoring model if unset).
LLM_EMAIL_STRUCTURE_PROVIDER=ollama
LLM_EMAIL_STRUCTURE_MODEL=qwen2.5:7b
# Route a hard task to the cloud by setting its provider + key, e.g.:
# LLM_DRAFTING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_TAILORING_PROVIDER=gemini
# GEMINI_API_KEY=...

# ---------- Groq (optional; free + fast cloud LLM, OpenAI-compatible) ----------
# Free key: https://console.groq.com/keys. One key, or several comma-separated keys
# you legitimately hold — the client rotates on rate-limit (429) then falls back to
# local Ollama, so you never hit a wall. (Don't farm throwaway accounts — Groq ToS.)
# GROQ_API_KEY=gsk_...
# GROQ_API_KEYS=gsk_key1,gsk_key2
# Recommended: heavy tasks on Groq's fast free model, fall back to local Ollama:
# LLM_EMAIL_STRUCTURE_PROVIDER=groq
# LLM_EMAIL_STRUCTURE_MODEL=llama-3.3-70b-versatile
# LLM_EMAIL_STRUCTURE_FALLBACK_PROVIDER=ollama
# LLM_DRAFTING_PROVIDER=groq
# LLM_DRAFTING_MODEL=llama-3.3-70b-versatile
# LLM_DRAFTING_FALLBACK_PROVIDER=ollama

# Legacy aliases (still honored as fallbacks): OLLAMA_SCORING_MODEL / OLLAMA_DRAFTING_MODEL.
# Per-call timeout (sec). Increase if the first call after a model swap is slow.
OLLAMA_TIMEOUT_S=120

# ---------- Email inbox triage (optional; set ALL THREE or NONE) ----------
# Reads your OWN inbox over IMAP: read-only sync + structuring, plus human-confirmed
# actions (draft reply / label / archive — never auto-send, never delete).
# Gmail: enable 2-Step Verification, then create an App Password
#   (Google Account -> Security -> App passwords) and paste it below.
# The app password is only ever sent to your mail server — never logged, stored, or
# put in an LLM prompt. Settings validation fails fast if you set only some of the three.
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_ADDRESS=you@gmail.com
EMAIL_APP_PASSWORD=

# ---------- Notifications (optional; Telegram is free) ----------
# Daily-report channel: telegram | discord | none.
# Telegram setup (free): 1) DM @BotFather -> /newbot -> copy the bot token below;
#   2) send your new bot any message, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...} below;
#   3) set NOTIFY_CHANNEL=telegram.
NOTIFY_CHANNEL=none
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=

# ---------- Semantic search / embeddings (optional; Postgres + pgvector) ----------
# Powers `hunt embed` / `hunt semantic`. Provider: ollama | openai | stub.
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# ---------- Background worker schedule (optional; values shown are the defaults) ----------
# Active window (local HH:MM) the scheduler runs discovery in; daily discovery cap.
WORKER_ACTIVE_START=09:30
WORKER_ACTIVE_END=21:00
WORKER_DAILY_CAP=30
WORKER_DISCOVERY_INTERVAL_MIN=180
WORKER_DISPATCH_INTERVAL_SEC=30
WORKER_API_DISCOVERY_INTERVAL_MIN=20
WORKER_API_SOURCES=remoteok,adzuna,weworkremotely,workingnomads,jobspresso,amazon,google

# ---------- Adzuna job source (optional; free official job-search API) ----------
# Free app id + key: https://developer.adzuna.com/  (then: hunt discover --source adzuna ...)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=in      # in | gb | us | au | ...

# ---------- Advanced / tuning (optional; values shown are the defaults) ----------
LOG_LEVEL=INFO
# LLM retry/backoff + cost table (JSON: {"model": [prompt_per_1k, completion_per_1k]}).
LLM_MAX_ATTEMPTS=2
LLM_BACKOFF_BASE_S=0.5
# LLM_COST_TABLE={"gpt-4o-mini": [0.00015, 0.0006]}
# Min seconds between browser scrapes per source (politeness / anti-block).
SCRAPE_MIN_INTERVAL_S=2.0
