# Rendered at container start by the nginx image's envsubst (only ${API_TOKEN} is
# substituted — nginx's own $host/$uri/$remote_addr are left untouched because they
# are not defined env vars). The /api/ location injects the shared bearer token so the
# browser never has to hold or paste it. Local single-user tool only — keep port 8080
# on localhost; do not expose it publicly.
server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback: unknown paths serve index.html so the hash router handles them
    location / {
        try_files $uri /index.html;
    }

    # Proxy API calls to the backend container — keeps the browser same-origin (no CORS
    # needed) and injects the shared API token so the UI works with zero config.
    location /api/ {
        proxy_pass         http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header   Authorization     "Bearer ${API_TOKEN}";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Also proxy the unauthenticated health endpoint (no token needed)
    location /health {
        proxy_pass         http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
